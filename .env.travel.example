# 复制为本项目 .env.travel；只填写你已有并授权使用的服务。
# demo 不需要任何密钥。ready 仅表示已配置，权限和额度会在调用时核验。

# 兼容原项目火山方舟配置，模型填写账号实际可用的名称或接入点 ID。
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_PRO_MODEL=
# 或任意 OpenAI 兼容服务：
TRAVEL_LLM_API_KEY=
TRAVEL_LLM_BASE_URL=
TRAVEL_LLM_MODEL=

# 网页搜索二选一；两者同时存在时优先博查。
BOCHA_API_KEY=
TAVILY_API_KEY=

# 先自行启动并登录 xpzouying/xiaohongshu-mcp；仅接受本机 URL。
XHS_MCP_URL=
# 如本地小红书服务配置了访问令牌，在此填写。
XHS_MCP_TOKEN=

# 抖音官方 aweme.dy.video_search 权限需获准；令牌用 client_token。
DOUYIN_SEARCH_TOKEN=
DOUYIN_DEVICE_ID=
